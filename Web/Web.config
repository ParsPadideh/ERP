<?xml version="1.0"?>
<configuration>
  <connectionStrings>
    <add name="DefaultConnection" connectionString="Data Source=.;Initial Catalog=FoodFactoryERP;Integrated Security=True" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <appSettings>
    <add key="CompanyName" value="بوستان "/>
    <add key="CompanyTagline" value="تولید و بسته‌بندی خشکبار، ادویه و دمنوش"/>
    <add key="CompanyAddress" value="خرم آباد، شهرک صنعتی شماره یک، خیابان ابتکار"/>
    <add key="CompanyPhone" value="021-55551234"/>
    <add key="CompanyEmail" value="info@goldensaffron.ir"/>
    <add key="CompanyWebsite" value="www.goldensaffron.ir"/>
    <add key="CompanyLogoUrl" value="~/Images/logo.png"/>
    <add key="CompanyNationalId" value="10101234567"/>
    <add key="CompanyEconomicCode" value="411234567890"/>
    <add key="SmtpHost" value="smtp.gmail.com"/>
    <add key="SmtpPort" value="587"/>
    <add key="SmtpUsername" value="your-email@gmail.com"/>
    <add key="SmtpPassword" value="your-app-password"/>
    <add key="SmtpFrom" value="noreply@goldensaffron.ir"/>
    <add key="SmtpFromName" value="کارخانه زعفران طلایی"/>
    <add key="SmtpEnableSsl" value="true"/>
    <!-- مسیر ذخیره‌ی فایل‌های بک‌آپ (نسبت به ریشه‌ی سایت) -->
    <add key="BackupPath" value="~/App_Data/Backups/"/>
    <!-- پوشه‌هایی که در بک‌آپ فایل‌ها زیپ می‌شوند (با کاما جدا شوند) -->
    <add key="BackupFolders" value="~/uploads/,~/assets/images/,~/assets/avatars/"/>
    <add key="AlertEngineSecret" value="CHANGE-ME-2026-ALERT-ENGINE-KEY-a1b2c3d4e5f6"/>
    <add key="PublicInvitationBaseUrl" value=""/>
    <add key="SmsIr_ApiKey" value="3xNqFHmvVIVAGlYVwm1D1GvdyaLapIY9pHgLzmKTTB3NeEVU"/>
    <!-- شناسه قالب تأیید — از پنل sms.ir → بخش ارسال سریع -->
    <add key="SmsIr_VerifyTemplateId" value="775142"/>
    <!-- نام پارامتر کلید در قالب پیامک (پیش‌فرض: CODE) -->
    <!-- مثال: اگر متن قالب "#CODE# کد ورود شما است" باشد، مقدار همان CODE است -->
    <add key="SmsIr_VerifyParamName" value="CODE"/>
  </appSettings>
  <system.web>
    <!-- ✅ Authentication -->
    <authentication mode="None"/>
    <!-- ✅ Compilation — فقط یک بار، با assemblies -->
    <compilation debug="true" targetFramework="4.8">
      <assemblies>
        <add assembly="System.IO.Compression, Version=4.2.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
        <add assembly="System.IO.Compression.FileSystem, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
        <add assembly="PresentationCore, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
        <add assembly="PresentationFramework, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
        <add assembly="WindowsBase, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
      </assemblies>
    </compilation>
    <!-- ✅ Cookies امن -->
    <httpCookies httpOnlyCookies="true" requireSSL="false" sameSite="Lax"/>
    <!-- ✅ Runtime -->
    <httpRuntime targetFramework="4.8" maxRequestLength="51200" executionTimeout="300" enableVersionHeader="false"/>
    <!-- ✅ Pages -->
    <pages controlRenderingCompatibilityVersion="4.0"/>
    <!-- ✅ Session — 8 ساعت (480 دقیقه) -->
    <sessionState mode="InProc" timeout="480" cookieless="UseCookies"/>
  </system.web>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- sitemap.xml → sitemap.xml.aspx -->
        <rule name="SitemapXml" stopProcessing="true">
          <match url="^sitemap\.xml$"/>
          <action type="Rewrite" url="sitemap.xml.aspx"/>
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>